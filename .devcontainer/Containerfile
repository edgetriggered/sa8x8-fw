# Stage 0: Base image pinned by digest for repeatable builds
FROM alpine@sha256:d56c381f961d307a21b3ca004cf1e3910f106644aefb1f43e654c8a56c4fd395 AS base

# Stage 1: Build toolchain with development dependencies
FROM base AS build

ARG TARGET
ARG BINUTILS_VER
ARG GCC_VER
ARG NEWLIB_VER
ARG GDB_VER

ENV PREFIX=/usr/local

RUN apk add --no-cache \
    build-base \
    gmp-dev mpfr-dev mpc1-dev zlib-dev \
    diffutils automake texinfo \
    libstdc++-dev \
    ca-certificates wget

WORKDIR /build

# binutils
RUN set -eux; \
    wget -q "https://ftp.gnu.org/gnu/binutils/binutils-${BINUTILS_VER}.tar.gz"; \
    tar xf "binutils-${BINUTILS_VER}.tar.gz"; \
    mkdir -p "binutils-${BINUTILS_VER}/build"; \
    cd "binutils-${BINUTILS_VER}/build"; \
    ../configure \
    --target="${TARGET}" \
    --prefix="${PREFIX}" \
    --disable-nls \
    --with-system-zlib; \
    make -j"$(nproc)"; \
    make install; \
    cd /build; \
    rm -rf "binutils-${BINUTILS_VER}"; \
    rm "binutils-${BINUTILS_VER}.tar.gz"

# gcc
RUN set -eux; \
    wget -q "https://ftp.gnu.org/gnu/gcc/gcc-${GCC_VER}/gcc-${GCC_VER}.tar.gz"; \
    tar xf "gcc-${GCC_VER}.tar.gz"; \
    mkdir -p "gcc-${GCC_VER}/build"; \
    cd "gcc-${GCC_VER}/build"; \
    ../configure \
    --target="${TARGET}" \
    --prefix="${PREFIX}" \
    --enable-languages=c \
    --disable-libssp \
    --disable-nls \
    --disable-threads \
    --disable-libgomp \
    --disable-libmudflap \
    --disable-libstdcxx-pch \
    --disable-multilib \
    --enable-lto \
    --with-system-zlib \
    --with-newlib; \
    make -j"$(nproc)"; \
    make install; \
    cd /build; \
    rm -rf "gcc-${GCC_VER}"; \
    rm "gcc-${GCC_VER}.tar.gz"

# newlib
RUN set -eux; \
    wget -q "https://sourceware.org/pub/newlib/newlib-${NEWLIB_VER}.tar.gz"; \
    tar xf "newlib-${NEWLIB_VER}.tar.gz"; \
    mkdir -p "newlib-${NEWLIB_VER}/build"; \
    cd "newlib-${NEWLIB_VER}/build"; \
    ../configure \
    --target="${TARGET}" \
    --prefix="${PREFIX}"; \
    make -j"$(nproc)"; \
    make install; \
    cd /build; \
    rm -rf "newlib-${NEWLIB_VER}"; \
    rm "newlib-${NEWLIB_VER}.tar.gz"

# gdb
RUN set -eux; \
    wget -q "https://sourceware.org/pub/gdb/releases/gdb-${GDB_VER}.tar.gz"; \
    tar xf "gdb-${GDB_VER}.tar.gz"; \
    mkdir -p "gdb-${GDB_VER}/build"; \
    cd "gdb-${GDB_VER}/build"; \
    CFLAGS="-g -O2 -std=gnu17" ../configure \
    --target="${TARGET}" \
    --prefix="${PREFIX}" \
    --disable-nls; \
    make -j"$(nproc)"; \
    make install; \
    cd /build; \
    rm -rf "gdb-${GDB_VER}"; \
    rm "gdb-${GDB_VER}.tar.gz"

# Strip debug info
RUN set -eux; \
    find /usr/local/bin /usr/local/lib /usr/local/libexec -type f \
    -exec sh -c 'for f; do strip --strip-unneeded "$f" 2>/dev/null || true; done' _ {} +

# Stage 2: Install toolchain with minimal runtime dependencies
FROM base AS runtime

ENV PATH=/usr/local/bin:$PATH

RUN apk add --no-cache \
    gmp mpfr mpc1 \
    zlib libstdc++ \
    make nano git \
    ca-certificates

COPY --from=build /usr/local /usr/local

RUN adduser -D toolbox

WORKDIR /home/toolbox
USER toolbox
